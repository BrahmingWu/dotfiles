#!/bin/sh
set -e

{{- if eq .chezmoi.os "darwin" }}
# MacOS build version: {{ output "sw_vers" "--buildVersion" }}
# Week of the year: {{ output "date" "+%y%V" }}
BREWFILE="{{ .chezmoi.sourceDir }}/ignorefiles/Brewfile"
command -v brew >/dev/null 2>&1 || exit 0

TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT
brew bundle dump --force --file "$TMPFILE"

count_lines() { wc -l < "$1" 2>/dev/null || echo 0; }
NEW_COUNT=$(count_lines "$TMPFILE")

if [ -f "$BREWFILE" ]; then
  OLD_COUNT=$(count_lines "$BREWFILE")
  if [ "$NEW_COUNT" -lt "$OLD_COUNT" ]; then
    echo "Brewfile: new ($NEW_COUNT) < existing ($OLD_COUNT), skipped"
    echo "  Run 'brew bundle dump --force' manually if intentional"
    exit 0
  fi
fi

mv "$TMPFILE" "$BREWFILE"
echo "Brewfile updated ($NEW_COUNT entries)"
{{- end }}
