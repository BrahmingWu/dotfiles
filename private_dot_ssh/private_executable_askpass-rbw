#!/bin/bash
# SSH_ASKPASS helper.
#
# OpenSSH contract (readpass.c:ssh_askpass):
#   exit 0   -> stdout is used verbatim as the answer (an empty answer is legal!)
#   exit != 0 -> ssh gets NULL, which most call sites turn into an empty answer
# So a prompt we cannot answer MUST either go to /dev/tty or fail loudly.
# Answering with an empty string is destructive: ssh-keygen -p reads "empty
# passphrase" as "remove the passphrase".
#
# Set SSH_ASKPASS_DEBUG=1 for trace output on stderr.
# Set SSH_ASKPASS_LOG=/path/to/file to append timestamped trace lines to a file
# (the only way to see what happened in a login that already finished).
# Set SSH_ASKPASS_TRUST_NEW_HOST=1 to auto-accept unknown host keys.

set -uo pipefail

prompt="${1-}"
dbg() {
  [ -z "${SSH_ASKPASS_DEBUG:-}" ] && [ -z "${SSH_ASKPASS_LOG:-}" ] && return 0
  [ -n "${SSH_ASKPASS_DEBUG:-}" ] && printf '[askpass] %s\n' "$*" >&2
  if [ -n "${SSH_ASKPASS_LOG:-}" ]; then
    printf '%s [askpass] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$SSH_ASKPASS_LOG" 2>/dev/null || true
  fi
  return 0
}

# ===== 0. Permission prompts (AddKeysToAgent confirm): deny by default =====
if [ "${SSH_ASKPASS_PROMPT:-}" = "confirm" ] || [ "${prompt#Add key }" != "$prompt" ]; then
  dbg "permission prompt -> no"
  printf 'no\n'
  exit 0
fi

# ===== 1. Interactive fallback =====
# NOTE: /dev/tty exists but open(2) fails with ENXIO when there is no
# controlling terminal, and bash prints an error before the || branch runs,
# so the whole open must run inside a redirected block.
tty_ask() {
  local a rc
  { exec 3<>/dev/tty; } 2>/dev/null || { dbg "no controlling tty"; return 1; }
  printf '%s' "$1" >&3 2>/dev/null
  IFS= read -rs a <&3 2>/dev/null
  rc=$?
  printf '\n' >&3 2>/dev/null
  exec 3<&- 3>&-
  # A failed read (EOF, interrupted) must not submit a partial line.
  [ "$rc" -eq 0 ] && [ -n "$a" ] || return 1
  printf '%s\n' "$a"
}

# notify_start() (FIDO user-presence) execs the askpass program purely to
# DISPLAY a message, with stdout on /dev/null. Reading stdin here would block
# the touch operation, so print and return without waiting for an answer.
if [ "${SSH_ASKPASS_PROMPT:-}" = "none" ]; then
  dbg "notify-only prompt"
  { printf '%s\n' "$prompt" >/dev/tty; } 2>/dev/null || true
  exit 0
fi

# ===== 2. Secret store (macOS Keychain first, rbw fallback) =====
# `timeout` is GNU coreutils and absent on macOS; gtimeout is the brew name.
# The first argument is the limit in seconds. rbw needs a generous one: its
# background agent can take >10s to start after a reboot, and a killed lookup
# silently degrades into a tty prompt.
with_timeout() {
  local secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then gtimeout "$secs" "$@"
  else "$@"
  fi
}

# Ensures rbw is usable before any lookup. A locked rbw makes `rbw get` block on
# an interactive unlock prompt; probing `rbw unlocked` costs ~13ms and avoids
# that hang. When locked we run `rbw unlock` so the master-password prompt
# (pinentry) appears INSTEAD of silently falling through to ssh's
# server-password prompt, which is easily mistaken for the rbw unlock prompt.
#
# Call this ONCE, from the main shell, before the candidate lookups: get_password
# runs inside command substitutions, so a flag set in there would be lost and
# every candidate entry name would re-open pinentry.
rbw_unlock_attempted=""
rbw_ensure_unlocked() {
  command -v rbw >/dev/null 2>&1 || return 1
  rbw unlocked >/dev/null 2>&1 && return 0
  [ -n "$rbw_unlock_attempted" ] && return 1
  rbw_unlock_attempted=1
  dbg "rbw locked; running rbw unlock"
  # No timeout here on purpose: this waits for the user to type the master
  # password into pinentry. stdout is the askpass answer channel, so it must be
  # discarded.
  rbw unlock >/dev/null 2>&1 || true
  rbw unlocked >/dev/null 2>&1
}

get_password() {
  local entry_name="$1" password=""

  if [ "$(uname)" = "Darwin" ]; then
    password=$(security find-generic-password -a "$USER" -s "$entry_name" -w 2>/dev/null) || true
  fi

  if [ -z "$password" ]; then
    command -v rbw >/dev/null 2>&1 || return 0
    # Never unlock from here (subshell): just bail out if still locked.
    rbw unlocked >/dev/null 2>&1 || { dbg "rbw locked: $entry_name"; return 0; }
    # rbw starts an agent on demand; right after a reboot that takes seconds.
    # 15s covers it, while a killed lookup would silently become a tty prompt.
    password=$(with_timeout 15 rbw get "$entry_name" 2>/dev/null)
    local rc=$?
    if [ "$rc" -ne 0 ]; then
      # rbw exits 1 for "no such entry", everything else is a real failure.
      case $rc in
        1) dbg "rbw miss: $entry_name" ;;
        *) dbg "rbw get failed: $entry_name (rc=$rc)" ;;
      esac
      password=""
    fi
  fi

  printf '%s' "$password"
}

# ===== 3. Prompt parsing =====
# OpenSSH puts the RESOLVED HostName in the password prompt, not the Host
# alias, so an IP is reverse-mapped back to its alias in ssh_config.
reverse_lookup_alias() {
  local target="$1"
  [ -f ~/.ssh/config ] || return 0
  awk -v tgt="$target" '
    /^[[:space:]]*Host[[:space:]]/ && $2 !~ /[?*]/ { alias=$2; next }
    /^[[:space:]]*HostName[[:space:]]/ {
      if ($2 == tgt && alias != "") { print alias; exit }
    }
  ' ~/.ssh/config 2>/dev/null
}

# "user@host's password:" / "(user@host) Password:" / "Password for user@host:"
extract_host() {
  local h
  h=$(printf '%s' "$1" | sed -nE 's/.*@\[([0-9A-Fa-f:]+)\].*/\1/p')
  [ -n "$h" ] && { printf '%s' "$h"; return; }
  printf '%s' "$1" | sed -nE 's/.*@([A-Za-z0-9._-]+).*/\1/p'
}

# "Enter passphrase for key '/path':" (ssh), "Enter passphrase for \"/path\":"
# (ssh-keygen), "Enter passphrase for /path:" (ssh-add).
# The quotes are followed by ":" and a space, so only the OPENING quote can be
# matched; requiring the whole string to end with a quote would miss these and
# leak the quotes into the entry name.
# Only returns something that looks like a path, so that the unquoted
# ssh-keygen prompts ("Enter new passphrase (empty for no passphrase):")
# do not masquerade as key filenames.
extract_keypath() {
  local t="${1#*assphrase for }" c
  t="${t#key }"
  case $t in
    \'*) t="${t#\'}"; printf '%s' "${t%%\'*}"; return ;;
    \"*) t="${t#\"}"; printf '%s' "${t%%\"*}"; return ;;
  esac
  c="${t%%:*}"
  case $c in
    */*) case $c in *" "*) return ;; *) printf '%s' "$c" ;; esac ;;
  esac
}

# ===== 4. Host key confirmation =====
case "$prompt" in
  *"continue connecting"*|*"authenticity of host"*)
    if [ -n "${SSH_ASKPASS_TRUST_NEW_HOST:-}" ]; then
      dbg "host key -> yes (SSH_ASKPASS_TRUST_NEW_HOST)"
      printf 'yes\n'
      exit 0
    fi
    tty_ask "$prompt" && exit 0
    dbg "unknown host key, not confirmed and no tty"
    exit 1
    ;;
esac

# Unlock once, up front, so pinentry is shown before ssh has already decided to
# ask for the server password. Must happen in the main shell (not inside
# get_password's subshell) and before the passphrase branch, which also needs it.
rbw_ensure_unlocked

# ===== 5. Key passphrase / PIN =====
lower=$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')
# Match real PIN prompts, not any host name containing "pin" (e.g. "shipping").
case "$lower" in
  *passphrase*|*"pin for"*|*"pin:"*|*"passcode"*)
    key_path=$(extract_keypath "$prompt")
    if [ -n "$key_path" ]; then
      passphrase=$(get_password "sshkey-$(basename "$key_path")")
      if [ -n "$passphrase" ]; then
        dbg "key passphrase hit: $key_path"
        printf '%s\n' "$passphrase"
        exit 0
      fi
      dbg "key passphrase miss: $key_path"
    else
      dbg "unmanaged passphrase prompt"
    fi
    # Never answer empty here: see the header comment.
    tty_ask "$prompt" && exit 0
    exit 1
    ;;
esac

# ===== 6. Login password =====
password_for_host() {
  local h="$1" pw=""
  [ -n "$h" ] || return 0
  pw=$(get_password "ssh-$h")
  if [ -z "$pw" ]; then
    case $h in
      [0-9]*)
        local a
        a=$(reverse_lookup_alias "$h")
        [ -n "$a" ] && pw=$(get_password "ssh-$a")
        ;;
    esac
  fi
  printf '%s' "$pw"
}

host_candidate=$(extract_host "$prompt")
password=""
parent_dest=""
[ -n "$host_candidate" ] && password=$(password_for_host "$host_candidate")

# Destination = first positional argument of the ssh command line. Options
# that take a value must be skipped with it, and a remote command must not be
# mistaken for the destination (`ssh host uptime` must yield `host`).
ssh_dest_from_argv() {
  local i=1 a
  while [ "$i" -lt "$ssh_argc" ]; do
    a="${ssh_argv[$i]}"
    case "$a" in
      --) i=$((i + 1))
          [ "$i" -lt "$ssh_argc" ] && printf '%s' "${ssh_argv[$i]}"
          return ;;
      -[bcDEeFIiJLlmOopQRSWw]) i=$((i + 2)) ;;
      -?*) i=$((i + 1)) ;;
      *) printf '%s' "$a"; return ;;
    esac
  done
}

# Loads the parent's argv into ssh_argv/ssh_argc. Linux has NUL-separated argv
# in procfs; macOS only has the space-joined `ps` rendering.
# (An explicit count keeps empty arrays away from `${#argv[@]}` under `set -u`,
# which misbehaves in the bash 3.2 shipped by macOS.)
load_parent_argv() {
  ssh_argv=()
  ssh_argc=0
  local a
  if [ "$(uname)" = "Darwin" ]; then
    local cmd
    cmd=$(ps -p "$PPID" -o command= 2>/dev/null) || return 1
    [ -n "$cmd" ] || return 1
    set -f
    # shellcheck disable=SC2206
    ssh_argv=($cmd)
    set +f
    ssh_argc=${#ssh_argv[@]}
  else
    [ -r "/proc/$PPID/cmdline" ] || return 1
    while IFS= read -r -d '' a; do
      ssh_argv+=("$a")
      ssh_argc=$((ssh_argc + 1))
    done < "/proc/$PPID/cmdline"
  fi
  [ "$ssh_argc" -gt 0 ]
}

if [ -z "$password" ] && load_parent_argv; then
  # Only trust the parent when it really is ssh; otherwise a wrapper (shell
  # function, python driver, ...) leaks its own arguments in here.
  case "${ssh_argv[0]##*/}" in
    ssh)
      ssh_target=$(ssh_dest_from_argv)
      if [ -n "$ssh_target" ]; then
        ssh_target="${ssh_target##*@}"
        ssh_target="${ssh_target#[}"
        ssh_target="${ssh_target%]}"
        password=$(password_for_host "$ssh_target")
        [ -n "$password" ] && parent_dest="$ssh_target"
      fi
      ;;
  esac
fi

if [ -n "$password" ]; then
  dbg "password hit: ${host_candidate:-${parent_dest:-?}}"
  printf '%s\n' "$password"
  exit 0
fi

dbg "password miss: ${host_candidate:-?}"
# If rbw is STILL locked after the unlock attempt, the prompt about to appear is
# ssh's SERVER password prompt — say so, otherwise it is easily mistaken for the
# rbw master-password prompt. Re-check: the flag only says "we tried".
if [ -n "$rbw_unlock_attempted" ] && command -v rbw >/dev/null 2>&1 &&
   ! rbw unlocked >/dev/null 2>&1; then
  printf '[askpass] rbw is LOCKED; the prompt below is for the SERVER password.\n' >&2
  printf '[askpass] run `rbw unlock` first to use the stored password.\n' >&2
fi
tty_ask "$prompt" && exit 0
exit 1
