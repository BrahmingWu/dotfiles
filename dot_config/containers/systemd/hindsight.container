# ~/.config/containers/systemd/hindsight.container
# Quadlet unit — converts to a systemd service automatically
# Docs: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Container]
Image=ghcr.io/vectorize-io/hindsight:latest-slim
ContainerName=hindsight
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=NO_PROXY=
Environment=http_proxy=
Environment=https_proxy=
Environment=no_proxy=
EnvironmentFile=%h/.config/containers/hindsight.env
UserNS=keep-id

# REST API + MCP
PublishPort=127.0.0.1:8888:8888
# Web UI
PublishPort=127.0.0.1:9999:9999

Network=caddy-net

Volume=%h/Documents/AppData/hindsight/data:/home/hindsight/.pg0

# The image's own shutdown script asks for 30s so the embedded pg0 can flush WAL;
# podman's default --stop-timeout is 10s, which SIGKILLs the container mid-task
# (that is also how operations end up stranded in 'processing').
StopTimeout=30
# Matches the upstream docker run line; PostgreSQL uses /dev/shm for parallel
# workers, and the default 64MiB is small for shared_buffers=256MB.
ShmSize=1g

# 容器内进程以非 root 运行时的安全标签
SecurityLabelDisable=true

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
